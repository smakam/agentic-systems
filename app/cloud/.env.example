# Shared non-secret configuration. Copy to app/cloud/.env (gitignored).
# Use literal values; never put API keys or passwords here.
export MARKETPLACE_GCP_PROJECT=YOUR_MARKETPLACE_PROJECT_ID
export MARKETPLACE_GCP_REGION=asia-south1
export AGENT_GCP_PROJECT=YOUR_AGENT_PROJECT_ID
export AGENT_GCP_REGION=us-central1
export MARKETPLACE_LF_HOST=https://cloud.langfuse.com
# Optional overrides (defaults are derived from AGENT_GCP_PROJECT):
# AGENT_STAGING_BUCKET=gs://your-private-staging-bucket
# AGENT_RUNTIME_SERVICE_ACCOUNT=marketplace-agent@your-agent-project.iam.gserviceaccount.com
