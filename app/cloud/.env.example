# Shared non-secret configuration for the full cloud setup.
# Copy to app/cloud/.env (gitignored), then source it from the repository root.
# No API keys or secret values belong here.
export MARKETPLACE_GCP_PROJECT=YOUR_MARKETPLACE_PROJECT_ID
export MARKETPLACE_GCP_REGION=asia-south1
export MARKETPLACE_LF_HOST=https://cloud.langfuse.com
export AGENT_GCP_PROJECT=YOUR_AGENT_PROJECT_ID
export AGENT_GCP_REGION=us-central1
export AGENT_STAGING_BUCKET=gs://YOUR_PRIVATE_AGENT_STAGING_BUCKET
export AGENT_RUNTIME_SERVICE_ACCOUNT=YOUR_AGENT_RUNTIME_SERVICE_ACCOUNT_EMAIL
export AGENT_MCP_SECRET_NAME=YOUR_AGENT_MCP_SECRET_NAME
