FROM node:22.22.2-alpine@sha256:8ea2348b068a9544dae7317b4f3aafcdc032df1647bb7d768a05a5cad1a7683f AS frontend
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_LANGFUSE_URL=http://localhost:3000
ARG VITE_LANGFUSE_PROJECT_ID=marketplace-support
RUN VITE_LANGFUSE_URL="$VITE_LANGFUSE_URL" VITE_LANGFUSE_PROJECT_ID="$VITE_LANGFUSE_PROJECT_ID" npm run build

FROM python:3.12.13-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36
WORKDIR /app
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/marketplace ./marketplace
COPY cloud/scripts/initialize.py /app/initialize.py
COPY data /data
COPY --from=frontend /build/dist /app/static
ENV PYTHONUNBUFFERED=1 INITIALIZE_ON_STARTUP=false DATA_DIR=/data SECURE_COOKIES=true PORT=8080
CMD ["sh", "-c", "exec uvicorn marketplace.cloud_web:app --host 0.0.0.0 --port ${PORT}"]
