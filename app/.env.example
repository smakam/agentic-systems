# Inference route: openai (default) or openrouter. Used by chat and embeddings.
INFERENCE_PROVIDER=openai
# Supply only the key for your selected route. Never commit real keys.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Claude judge through the shared gateway (direct Anthropic)
ANTHROPIC_API_KEY=
# Generated by scripts/provision-gateway-keys.py; do not paste master/provider keys here.
SUPPORT_GATEWAY_KEY=
EVAL_GATEWAY_KEY=
JUDGE_GATEWAY_KEY=

# Read-only agent tool access: mcp (local stdio subprocess) or direct.
AGENT_TOOL_TRANSPORT=mcp

# Optional Lakera v2 guardrail. Configure a project policy if desired.
LAKERA_API_KEY=
LAKERA_PROJECT_ID=

# Optional hosted runtime selector. Secrets remain server-side.
LYZR_AGENT_ID=
LYZR_API_KEY=
GOOGLE_RUNTIME_RESOURCE=
# Google ADC must be available INSIDE the backend container (read-only mount).
GOOGLE_APPLICATION_CREDENTIALS=
# Keep stable; use a different namespace for test and cloud users.
MARKETPLACE_IDENTITY_NAMESPACE=marketplace-local

# Startup provisions this scoped identity for Operator model/embedding usage.
OPERATOR_GATEWAY_KEY=

# Optional A2A support + simulated delivery lab (compose.a2a.yaml).
# Use two distinct random secrets; browser and Agent Cards never receive them.
DELIVERY_READ_TOKEN=
DELIVERY_WRITE_TOKEN=
# Same configured gateway/model as marketplace support, separate bounded run.
DELIVERY_MODEL_ALIAS=support-model
